<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.17.11</Version>
    <AssemblyName>BaumLaunch</AssemblyName>
    <RootNamespace>BaumLaunch</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyTitle>BaumLaunch</AssemblyTitle>
    <Product>BaumLaunch</Product>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
  </ItemGroup>
</Project>
